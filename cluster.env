# Inkling-2-Small IQ4_XS over llama.cpp RPC (RDMA) on a 3-node DGX Spark CX7 ring.
# Head (JoshDGX) runs llama-server; the other two run ggml-rpc-server bound to the
# fabric IP of the cable that goes straight to the head.
LLAMA_DIR=/home/joshhu/workspace/llama.cpp
MODEL=/home/joshhu/models/Inkling-2-Small-IQ4_XS/Inkling-2-Small-IQ4_XS/Inkling-2-Small-IQ4_XS-00001-of-00009.gguf
ALIAS=inkling-2-small
RPC_PORT=50052
# host(mgmt)      bind IP (fabric, link to head)
RPC_NODES="192.168.1.93=10.20.0.12 192.168.1.234=10.20.4.13"
API_HOST=0.0.0.0
API_PORT=8090
CTX=262144
PARALLEL=1
# Compute buffer scales with CTX x UBATCH (no flash-attn path for Inkling2's relative attention):
# 1M x 512 needed ~205 GiB/device. 256K x 64 is ~6.6 GiB. Raise UBATCH only with care.
UBATCH=64
# Device order is RPC0 (JoshDGX2), RPC1 (JoshDGX3), CUDA0 (JoshDGX). Layers are not equal size; 15/16/17 of 48 balances ~102 GiB each.
TENSOR_SPLIT=15,16,17
